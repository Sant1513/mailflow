# ── Database ────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mailflow"
# Only needed when DATABASE_URL points at a pooled/PgBouncer endpoint (e.g.
# Neon's "-pooler" host) — Prisma Migrate needs a direct connection for
# advisory locks. Set DIRECT_URL to the same host without "-pooler".
DIRECT_URL=""

# ── Redis / Queue ───────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ── Auth (NextAuth / Google OAuth login) ───────────────────────────────
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Session signing secret — REQUIRED in production (NextAuth refuses to start
# without it). AUTH_SECRET is also accepted. Generate: openssl rand -base64 32
NEXTAUTH_SECRET=""
# Must match the deployed origin exactly, e.g. https://mailflow.vercel.app
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
ALLOWED_EMAIL_DOMAIN="masaischool.com"

# ── Gmail send/sync OAuth (separate, incremental consent) ─────────────
# Uses the same GOOGLE_CLIENT_ID/SECRET with additional scopes requested
# at /settings/gmail/connect — see lib/gmail/oauth.ts
GMAIL_PUBSUB_TOPIC="" # projects/<project>/topics/mailflow-gmail
GMAIL_PUBSUB_VERIFICATION_TOKEN="" # shared secret checked on the webhook URL

# ── Secrets ─────────────────────────────────────────────────────────────
ENCRYPTION_KEY="" # 32-byte key, base64: openssl rand -base64 32

# ── AI (Gemini) — optional, app must run without it ────────────────────
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"

# ── Sending limits ──────────────────────────────────────────────────────
EMAIL_RATE_LIMIT_PER_MINUTE="20"
