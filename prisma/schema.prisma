// MailFlow â€” Prisma schema
// See ARCHITECTURE.md for the relationship rules and indexing rationale.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Neon's pooled endpoint (PgBouncer, transaction mode) doesn't support the
  // advisory locks Prisma Migrate needs, so migrations run over a direct,
  // unpooled connection while the app itself uses the pooled DATABASE_URL.
  directUrl = env("DIRECT_URL")
}

// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
// ORG / AUTH
// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

enum Role {
  SUPER_ADMIN
  ADMIN
  OPERATOR
  VIEWER
}

enum UserStatus {
  ACTIVE
  PENDING
  DISABLED
}

model Organization {
  id            String   @id @default(cuid())
  name          String
  allowedDomain String   @unique // "masaischool.com"
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  users               User[]
  workspaces          Workspace[]
  auditLogs           AuditLog[]
  contacts            Contact[]
  aiUsage             AiUsage[]
  retentionPolicy     RetentionPolicy?
  integrationSettings IntegrationSettings?
}

model User {
  id             String     @id @default(cuid())
  organizationId String
  // Optional: the authoritative Google subject lives in Account.providerAccountId.
  // NextAuth's adapter creates the User before any account is linked, so this
  // cannot be required â€” making it so broke sign-in with OAuthAccountNotLinked.
  googleId       String?    @unique
  email          String     @unique
  name           String
  // `image` and `emailVerified` are the field names NextAuth's PrismaAdapter
  // writes. They must exist with these exact names or adapter.createUser fails.
  image          String?
  emailVerified  DateTime?
  role           Role       @default(OPERATOR)
  status         UserStatus @default(ACTIVE)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  lastLoginAt    DateTime?
  // Slack member id (Uâ€¦): mentions in assignment / resolution notifications.
  slackUserId      String?
  emailSignature   String?  @db.Text

  organization           Organization           @relation(fields: [organizationId], references: [id])
  ownedWorkspaces        Workspace[]            @relation("WorkspaceOwner")
  workspaceMemberships   WorkspaceMember[]
  accounts               Account[]
  sessions               Session[]
  emailProviderAccounts  EmailProviderAccount[]
  auditLogs              AuditLog[]
  notifications          Notification[]
  aiUsage                AiUsage[]
  internalNotes          InternalNote[]
  assignedConversations  Conversation[]         @relation("ConversationAssignee")
  campaignsCreated       Campaign[]             @relation("CampaignCreatedBy")
  templatesOwned         Template[]             @relation("TemplateOwner")
  documentTemplatesOwned DocumentTemplate[]     @relation("DocumentTemplateOwner")
  datasetsOwned          Dataset[]              @relation("DatasetOwner")
  recordChanges          RecordChangeHistory[]
  suppressionsAdded      EmailSuppression[]     @relation("SuppressionAddedBy")
  contactSegments        ContactSegment[]
  scheduledReplies       ScheduledReply[]
  slaRules               SlaRule[]
  signingRequestsSent    SigningRequest[]        @relation("SigningRequestsSentBy")
  signingTemplatesCreated SigningTemplate[]      @relation("SigningTemplateCreatedBy")

  @@index([organizationId])
}

// NextAuth (Auth.js) adapter models â€” database session strategy.
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Workspace {
  id             String   @id @default(cuid())
  organizationId String
  ownerId        String
  name           String
  disabled       Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id])
  owner        User              @relation("WorkspaceOwner", fields: [ownerId], references: [id])
  members      WorkspaceMember[]

  contacts              Contact[]
  datasets              Dataset[]
  templates             Template[]
  documentTemplates     DocumentTemplate[]
  campaigns             Campaign[]
  automations           Automation[]
  emailProviderAccounts EmailProviderAccount[]
  notifications         Notification[]
  aiUsage               AiUsage[]
  tags                  Tag[]
  conversations         Conversation[]
  suppressions          EmailSuppression[]
  scheduledReplies      ScheduledReply[]
  contactSegments       ContactSegment[]
  slaRules              SlaRule[]
  webhookEndpoints      WebhookEndpoint[]
  signingRequests       SigningRequest[]
  signingTemplates      SigningTemplate[]
  signingBatches        SigningBatch[]

  @@index([organizationId])
}

model WorkspaceMember {
  id          String   @id @default(cuid())
  workspaceId String
  userId      String
  role        Role     @default(OPERATOR)
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id])
  user      User      @relation(fields: [userId], references: [id])

  @@unique([workspaceId, userId])
}

// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
// CONTACTS
// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model Contact {
  id             String   @id @default(cuid())
  organizationId String
  workspaceId    String
  name           String?
  primaryEmail   String
  phone          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  workspace    Workspace    @relation(fields: [workspaceId], references: [id])

  records          Record[]
  conversations    Conversation[]
  recipientHistory RecipientHistory[]
  campaignRecords  CampaignRecord[]

  @@unique([workspaceId, primaryEmail])
  @@index([primaryEmail])
}

model ContactSegment {
  id          String   @id @default(cuid())
  workspaceId String
  createdById String
  name        String
  description String?
  filters     Json     // { primaryEmail?: string, name?: string, hasConversation?: boolean, tags?: string[] }
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User      @relation(fields: [createdById], references: [id])

  @@index([workspaceId])
}

// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
// DATASETS / RECORDS
// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

enum ColumnType {
  TEXT
  LONG_TEXT
  EMAIL
  NUMBER
  DATE
  DATETIME
  CHECKBOX
  SINGLE_SELECT
  MULTI_SELECT
  URL
  STATUS
  FORMULA
}

model Dataset {
  id             String   @id @default(cuid())
  organizationId String
  workspaceId    String
  ownerId        String
  name           String
  description    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id])
  owner     User      @relation("DatasetOwner", fields: [ownerId], references: [id])

  columns    DatasetColumn[]
  records    Record[]
  savedViews SavedView[]
  campaigns  Campaign[]

  @@index([workspaceId])
}

model DatasetColumn {
  id        String     @id @default(cuid())
  datasetId String
  key       String // stable key used inside Record.data jsonb
  label     String
  type      ColumnType
  options   Json? // for SINGLE_SELECT/MULTI_SELECT: string[]; FORMULA: { expr }
  isSystem  Boolean    @default(false) // e.g. email status fields, Â§14
  order     Int        @default(0)
  hidden    Boolean    @default(false)
  width     Int?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  dataset Dataset @relation(fields: [datasetId], references: [id], onDelete: Cascade)

  @@unique([datasetId, key])
  @@index([datasetId])
}

model Record {
  id                         String    @id @default(cuid())
  datasetId                  String
  contactId                  String?
  data                       Json // { [columnKey]: value } â€” business fields only
  // System email fields (Â§14) kept out of `data` so business Status is
  // never overwritten by the send pipeline:
  emailStatus                String? // NOT_SENT | QUEUED | SENT | FAILED | SKIPPED
  lastEmailSentAt            DateTime?
  lastEmailError             String?
  lastBatchId                String?
  replyReceived              Boolean   @default(false)
  replyReceivedAt            DateTime?
  lastReplyAt                DateTime?
  lastCommunicationAt        DateTime?
  lastCommunicationDirection String? // INBOUND | OUTBOUND
  conversationId             String?
  gmailThreadId              String?
  unreadReply                Boolean   @default(false)
  followUpRequired           Boolean   @default(false)
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt

  dataset Dataset  @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  contact Contact? @relation(fields: [contactId], references: [id])

  campaignRecords CampaignRecord[]
  changeHistory   RecordChangeHistory[]
  emailJobs       EmailJob[]

  @@index([datasetId])
  @@index([contactId])
  @@index([emailStatus])
}

model SavedView {
  id        String   @id @default(cuid())
  datasetId String
  name      String
  filter    Json // condition tree, same shape as automation conditions
  sort      Json?
  groupBy   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  dataset Dataset @relation(fields: [datasetId], references: [id], onDelete: Cascade)

  @@index([datasetId])
}

model RecordChangeHistory {
  id        String   @id @default(cuid())
  recordId  String
  actorId   String?
  field     String
  oldValue  Json?
  newValue  Json?
  reason    String? // e.g. "automation triggered", "manual edit"
  createdAt DateTime @default(now())

  record Record @relation(fields: [recordId], references: [id], onDelete: Cascade)
  actor  User?  @relation(fields: [actorId], references: [id])

  @@index([recordId])
}

// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
// TEMPLATES
// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model Template {
  id             String   @id @default(cuid())
  organizationId String
  workspaceId    String
  ownerId        String
  name           String
  description    String?
  archived       Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id])
  owner     User      @relation("TemplateOwner", fields: [ownerId], references: [id])

  versions  TemplateVersion[]
  campaigns Campaign[]

  @@index([workspaceId])
}

model TemplateVersion {
  id          String   @id @default(cuid())
  templateId  String
  version     Int
  subject     String
  html        String   @db.Text
  css         String?  @db.Text
  plainText   String?  @db.Text
  variables   Json // string[] detected {{Var}} names, cached at save time
  createdById String
  createdAt   DateTime @default(now())

  template  Template   @relation(fields: [templateId], references: [id], onDelete: Cascade)
  campaigns Campaign[]
  emailJobs EmailJob[]

  @@unique([templateId, version])
  @@index([templateId])
}

// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
// EMAIL PROVIDER (Gmail) ACCOUNTS
// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

enum EmailProvider {
  GMAIL
  SMTP
  SENDGRID
  SES
  RESEND
}

model EmailProviderAccount {
  id              String        @id @default(cuid())
  organizationId  String
  workspaceId     String
  userId          String
  provider        EmailProvider @default(GMAIL)
  emailAddress    String
  displayName     String?
  // Encrypted at rest (AES-256-GCM); never sent to the browser.
  accessTokenEnc  String?       @db.Text
  refreshTokenEnc String?       @db.Text
  tokenExpiresAt  DateTime?
  scope           String?
  gmailHistoryId  String?
  watchExpiresAt  DateTime?
  status          String        @default("CONNECTED") // CONNECTED | DISCONNECTED | EXPIRED
  lastSyncAt      DateTime?
  lastVerifiedAt  DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id])
  user      User      @relation(fields: [userId], references: [id])

  emailJobs     EmailJob[]
  conversations Conversation[]

  @@unique([workspaceId, userId, provider])
  @@index([workspaceId])
}

// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
// CAMPAIGNS / BATCHES / EMAIL JOBS
// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

enum CampaignStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  SCHEDULED
  RUNNING
  PAUSED
  COMPLETED
  PARTIALLY_FAILED
  CANCELLED
  REJECTED
}

model Campaign {
  id                       String         @id @default(cuid())
  organizationId           String
  workspaceId              String
  name                     String
  description              String?
  datasetId                String
  templateId               String
  templateVersionId        String
  automationId             String?
  senderAccountId          String?
  // Â§22 sender/recipient settings. The From ADDRESS is never configurable â€”
  // it is pinned to the connected mailbox (Â§28) â€” but the display name,
  // Reply-To and Cc/Bcc are. Cc/Bcc are added to every message in the
  // campaign, so they are for supervisors/archives, not per-recipient.
  fromName                 String?
  replyTo                  String?
  ccEmails                 String[]
  bccEmails                String[]
  status                   CampaignStatus @default(DRAFT)
  scheduledAt              DateTime?
  timezone                 String         @default("Asia/Kolkata")
  createdById              String
  approvedById             String?
  approvedAt               DateTime?
  rejectionReason          String?
  // Approval workflow (Â§36) â€” request/decision emails live in one Gmail thread.
  submittedAt              DateTime?
  rejectedAt               DateTime?
  reviewedById             String?
  approvalRemarks          String?        @db.Text
  approvalRequestAccountId String?
  approvalRequestMessageId String?
  approvalRequestThreadId  String?
  approvalRequestEmail     String? // SENT | SKIPPED: <why> | FAILED: <why>
  approvalDecisionEmail    String?
  createdAt                DateTime       @default(now())
  updatedAt                DateTime       @updatedAt

  workspace       Workspace       @relation(fields: [workspaceId], references: [id])
  dataset         Dataset         @relation(fields: [datasetId], references: [id])
  template        Template        @relation(fields: [templateId], references: [id])
  templateVersion TemplateVersion @relation(fields: [templateVersionId], references: [id])
  automation      Automation?     @relation(fields: [automationId], references: [id])
  createdBy       User            @relation("CampaignCreatedBy", fields: [createdById], references: [id])

  campaignRecords  CampaignRecord[]
  batches          Batch[]
  emailJobs        EmailJob[]
  documents        CampaignDocument[]
  trackingEvents   EmailTrackingEvent[]
  emailSuppressions EmailSuppression[]

  @@index([workspaceId])
  @@index([status])
}

model CampaignRecord {
  id            String  @id @default(cuid())
  campaignId    String
  recordId      String
  contactId     String?
  // snapshot of validation at add-time; refreshed by dry run
  isValid       Boolean @default(true)
  invalidReason String?
  isDuplicate   Boolean @default(false)

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  record   Record   @relation(fields: [recordId], references: [id])
  contact  Contact? @relation(fields: [contactId], references: [id])

  @@unique([campaignId, recordId])
  @@index([campaignId])
}

enum BatchStatus {
  PREPARING
  QUEUED
  RUNNING
  PAUSED
  COMPLETED
  PARTIALLY_FAILED
  FAILED
  CANCELLED
}

model Batch {
  id           String      @id @default(cuid())
  campaignId   String
  label        String // e.g. BATCH-2026-09-04-001
  status       BatchStatus @default(PREPARING)
  total        Int         @default(0)
  validCount   Int         @default(0)
  sentCount    Int         @default(0)
  failedCount  Int         @default(0)
  skippedCount Int         @default(0)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  campaign Campaign   @relation(fields: [campaignId], references: [id])
  jobs     EmailJob[]

  @@unique([campaignId, label])
  @@index([campaignId])
}

enum EmailJobStatus {
  QUEUED
  SENDING
  SENT
  FAILED
  SKIPPED
  CANCELLED
}

model EmailJob {
  id                     String         @id @default(cuid())
  batchId                String
  campaignId             String
  recordId               String
  templateVersionId      String
  emailProviderAccountId String?
  status                 EmailJobStatus @default(QUEUED)

  // immutable send snapshot (Â§89)
  toEmail   String
  ccEmails  String[]
  bccEmails String[]
  fromName  String
  fromEmail String
  replyTo   String?
  subject   String
  html      String   @db.Text
  plainText String?  @db.Text

  gmailMessageId  String?
  gmailThreadId   String?
  messageIdHeader String?

  sendReason       String?   @db.Text
  skipReason       String?   @db.Text
  errorCode        String?
  errorMessage     String?   @db.Text
  providerResponse Json?
  retryCount       Int       @default(0)
  lastAttemptAt    DateTime?

  sentAt           DateTime?
  unsubscribeToken String?   @unique
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  batch                Batch                 @relation(fields: [batchId], references: [id])
  campaign             Campaign              @relation(fields: [campaignId], references: [id])
  record               Record                @relation(fields: [recordId], references: [id])
  templateVersion      TemplateVersion       @relation(fields: [templateVersionId], references: [id])
  emailProviderAccount EmailProviderAccount? @relation(fields: [emailProviderAccountId], references: [id])
  attachments          Attachment[]
  trackingEvents       EmailTrackingEvent[]

  @@unique([campaignId, recordId, templateVersionId])
  @@index([batchId])
  @@index([status])
}

// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
// AUTOMATIONS
// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model Automation {
  id             String   @id @default(cuid())
  organizationId String
  workspaceId    String
  datasetId      String?
  name           String
  enabled        Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  workspace Workspace           @relation(fields: [workspaceId], references: [id])
  versions  AutomationVersion[]
  runs      AutomationRun[]
  campaigns Campaign[]

  @@index([workspaceId])
}

model AutomationVersion {
  id              String   @id @default(cuid())
  automationId    String
  version         Int
  triggerType     String // RECORD_MATCHES_CONDITIONS | RECORD_CREATED | RECORD_UPDATED | MANUAL | SCHEDULED
  triggerConfig   Json // e.g. cron for SCHEDULED
  conditions      Json // condition tree: { op: AND|OR, rules: [...] }
  actions         Json // ordered list of { type, config }
  stopConditions  Json? // condition tree, evaluated before each action pass
  frequencyPolicy Json // { mode: ONCE|ONCE_PER_DAY|ONCE_PER_WEEK|ONCE_PER_CAMPAIGN|ALLOW_REPEATED, cooldownDays? }
  createdById     String
  createdAt       DateTime @default(now())

  automation Automation      @relation(fields: [automationId], references: [id], onDelete: Cascade)
  runs       AutomationRun[]

  @@unique([automationId, version])
  @@index([automationId])
}

model AutomationRun {
  id                  String   @id @default(cuid())
  automationId        String
  automationVersionId String
  recordId            String?
  triggerType         String
  conditionsMet       Boolean
  actionTaken         String?
  result              String // TRIGGERED | SKIPPED | ERROR
  error               String?
  createdAt           DateTime @default(now())

  automation        Automation        @relation(fields: [automationId], references: [id])
  automationVersion AutomationVersion @relation(fields: [automationVersionId], references: [id])

  @@index([automationId])
  @@index([recordId])
}

// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
// CONVERSATIONS / INBOX
// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

enum ConversationStatus {
  OPEN
  IN_PROGRESS
  WAITING_FOR_STUDENT
  RESOLVED
  CLOSED
}

model Conversation {
  id                     String             @id @default(cuid())
  organizationId         String
  workspaceId            String
  ownerId                String
  contactId              String
  recipientEmail         String
  subject                String
  emailProviderAccountId String
  gmailThreadId          String?
  status                 ConversationStatus @default(OPEN)
  assigneeId             String?
  firstMessageAt         DateTime?
  lastMessageAt          DateTime?
  messageCount           Int                @default(0)
  unread                 Boolean            @default(false)
  // Assignment notification threads (email + Slack), continued on resolution.
  notifyEmailAccountId   String?
  notifyEmailMessageId   String?
  notifyEmailThreadId    String?
  notifySlackChannelId   String?
  notifySlackThreadTs    String?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  workspace Workspace            @relation(fields: [workspaceId], references: [id])
  contact   Contact              @relation(fields: [contactId], references: [id])
  account   EmailProviderAccount @relation(fields: [emailProviderAccountId], references: [id])
  assignee  User?                @relation("ConversationAssignee", fields: [assigneeId], references: [id])

  messages         ConversationMessage[]
  notes            InternalNote[]
  tags             ConversationTag[]
  followUps        FollowUp[]
  scheduledReplies ScheduledReply[]

  @@unique([emailProviderAccountId, gmailThreadId])
  @@index([workspaceId])
  @@index([contactId])
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageClassification {
  HUMAN_REPLY
  OUT_OF_OFFICE
  BOUNCE
  DELIVERY_FAILURE
  AUTO_REPLY
  UNKNOWN
}

model ConversationMessage {
  id                       String                @id @default(cuid())
  conversationId           String
  gmailMessageId           String?
  gmailThreadId            String?
  direction                MessageDirection
  classification           MessageClassification @default(UNKNOWN)
  classificationConfidence Float?
  // Â§80 AI intent â€” stored beside the header-first classification, never in place of it.
  aiIntent                 String?
  aiIntentConfidence       Float?
  aiIntentReason           String?
  senderEmail              String
  senderName               String?
  recipientEmail           String
  cc                       String[]
  bcc                      String[]
  subject                  String?
  messageIdHeader          String?
  inReplyTo                String?
  references               String?
  htmlBody                 String?               @db.Text
  plainTextBody            String?               @db.Text
  snippet                  String?
  sentAt                   DateTime?
  receivedAt               DateTime?
  status                   String                @default("RECEIVED")
  isRead                   Boolean               @default(false)
  hasAttachments           Boolean               @default(false)
  createdAt                DateTime              @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  attachments  Attachment[]

  @@unique([gmailMessageId])
  @@index([conversationId])
}

model InternalNote {
  id             String   @id @default(cuid())
  conversationId String
  authorId       String
  body           String   @db.Text
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  author       User         @relation(fields: [authorId], references: [id])

  @@index([conversationId])
}

model ScheduledReply {
  id             String    @id @default(cuid())
  conversationId String
  workspaceId    String
  createdById    String
  scheduledFor   DateTime
  html           String    @db.Text
  plainText      String    @db.Text
  cc             String[]
  newThread      Boolean   @default(false)
  status         String    @default("PENDING") // PENDING | SENT | CANCELLED | FAILED
  errorMessage   String?
  sentAt         DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  workspace    Workspace    @relation(fields: [workspaceId], references: [id])
  createdBy    User         @relation(fields: [createdById], references: [id])

  @@index([conversationId])
  @@index([status, scheduledFor])
}

model Tag {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  color       String?
  createdAt   DateTime @default(now())

  workspace     Workspace         @relation(fields: [workspaceId], references: [id])
  conversations ConversationTag[]

  @@unique([workspaceId, name])
}

model ConversationTag {
  conversationId String
  tagId          String

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  tag          Tag          @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([conversationId, tagId])
}

model FollowUp {
  id             String    @id @default(cuid())
  conversationId String
  dueDate        DateTime
  note           String?
  completed      Boolean   @default(false)
  remindedAt     DateTime?
  createdAt      DateTime  @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([dueDate])
}

model RecipientHistory {
  id        String   @id @default(cuid())
  contactId String
  type      String // EMAIL_SENT | REPLY | NOTE | STATUS_CHANGE | FOLLOW_UP
  summary   String
  refId     String? // id of the related EmailJob / ConversationMessage / etc.
  createdAt DateTime @default(now())

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([contactId])
}

model Attachment {
  id                    String   @id @default(cuid())
  emailJobId            String?
  conversationMessageId String?
  gmailAttachmentId     String?
  filename              String
  mimeType              String
  size                  Int
  createdAt             DateTime @default(now())

  // Personalised campaign documents: the frozen inputs needed to regenerate
  // the exact PDF that was attached (values, reference, recipient, issue
  // date), plus the SHA-256 of the bytes actually sent.
  campaignDocumentId String?
  fieldValues        Json?
  documentRef        String?
  sha256             String?
  generatedAt        DateTime?

  emailJob            EmailJob?            @relation(fields: [emailJobId], references: [id])
  conversationMessage ConversationMessage? @relation(fields: [conversationMessageId], references: [id])
  campaignDocument    CampaignDocument?    @relation(fields: [campaignDocumentId], references: [id], onDelete: SetNull)

  @@index([emailJobId])
  @@index([campaignDocumentId])
}

// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
// PERSONALISED DOCUMENTS (PDF agreements / forms attached to campaigns)
// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

/// Immutable uploaded PDF bytes, content-addressed per organisation. Never
/// updated in place: replacing a document's PDF creates a new row, so a
/// campaign snapshot keeps generating from the file it was approved with.
model DocumentFile {
  id             String   @id @default(cuid())
  organizationId String
  sha256         String
  fileName       String
  size           Int
  data           Bytes
  pageCount      Int
  pages          Json // [{ width, height, rotation }] in PDF points
  formFields     Json // detected AcroForm fields with page + rect
  hasXfa         Boolean  @default(false)
  createdById    String
  createdAt      DateTime @default(now())

  documentTemplates DocumentTemplate[]
  campaignDocuments CampaignDocument[]

  @@unique([organizationId, sha256])
}

enum DocumentLockMode {
  FLATTEN
  LOCK_FILLED
  EDITABLE
}

model DocumentTemplate {
  id              String           @id @default(cuid())
  organizationId  String
  workspaceId     String
  ownerId         String
  name            String
  description     String?
  fileId          String
  fields          Json             @default("[]")
  fileNamePattern String
  lockMode        DocumentLockMode @default(FLATTEN)
  stampReference  Boolean          @default(true)
  archived        Boolean          @default(false)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  workspace         Workspace          @relation(fields: [workspaceId], references: [id])
  owner             User               @relation("DocumentTemplateOwner", fields: [ownerId], references: [id])
  file              DocumentFile       @relation(fields: [fileId], references: [id])
  campaignDocuments CampaignDocument[]

  @@index([workspaceId])
}

/// A document attached to a campaign. Holds a SNAPSHOT of the library
/// document (file + field map + options) taken when attached or refreshed,
/// so editing the library never changes what an approved campaign sends.
model CampaignDocument {
  id                 String           @id @default(cuid())
  campaignId         String
  documentTemplateId String
  name               String
  fileId             String
  fields             Json
  fileNamePattern    String
  lockMode           DocumentLockMode
  stampReference     Boolean
  snapshotAt         DateTime         @default(now())
  order              Int              @default(0)
  createdAt          DateTime         @default(now())

  campaign         Campaign         @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  documentTemplate DocumentTemplate @relation(fields: [documentTemplateId], references: [id])
  file             DocumentFile     @relation(fields: [fileId], references: [id])
  attachments      Attachment[]

  @@unique([campaignId, documentTemplateId])
  @@index([campaignId])
}

// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
// NOTIFICATIONS / AUDIT / AI
// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model Notification {
  id          String   @id @default(cuid())
  workspaceId String
  userId      String
  type        String // NEW_REPLY | ASSIGNMENT | FOLLOW_UP_DUE | ... (Â§87)
  title       String
  body        String?
  link        String?
  read        Boolean  @default(false)
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id])
  user      User      @relation(fields: [userId], references: [id])

  @@index([userId])
}

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String
  actorId        String?
  action         String
  targetType     String?
  targetId       String?
  metadata       Json?
  ip             String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  actor        User?        @relation(fields: [actorId], references: [id])

  @@index([organizationId])
  @@index([createdAt])
}

model AiUsage {
  id             String   @id @default(cuid())
  organizationId String
  workspaceId    String
  userId         String
  feature        String
  success        Boolean
  tokensUsed     Int?
  latencyMs      Int?
  errorReason    String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  workspace    Workspace    @relation(fields: [workspaceId], references: [id])
  user         User         @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([organizationId, createdAt])
}

// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
// RETENTION (Â§130)
// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

// Per-organization retention policy. Null days = keep forever. Configuring
// a policy never deletes anything by itself: enforcement is a separate,
// explicit, audited step ("Do not delete historical communication
// accidentally" â€” Â§130). This table records intent plus who set it.

model RetentionPolicy {
  id               String   @id @default(cuid())
  organizationId   String   @unique
  // Strip stored HTML/plain bodies of inbound/outbound messages older than N days.
  messageBodyDays  Int?
  // Strip the rendered html/plainText snapshot of sent EmailJobs older than N days.
  emailJobBodyDays Int?
  // Delete audit-log rows older than N days.
  auditLogDays     Int?
  updatedById      String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
}

// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
// INTEGRATIONS / SNIPPETS
// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

// Per-organisation Slack settings. The bot token itself is SLACK_BOT_TOKEN in
// the environment and never stored here.
model IntegrationSettings {
  id                     String   @id @default(cuid())
  organizationId         String   @unique
  slackChannelId         String?
  slackNotifyAssignments Boolean  @default(true)
  slackNotifyResolutions Boolean  @default(true)
  slackNotifyFollowUps   Boolean  @default(true)
  updatedById            String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
}

// Saved replies for the inbox composer; {{Name}}-style variables resolve
// against the conversation's contact and record.
model ReplySnippet {
  id          String   @id @default(cuid())
  workspaceId String
  createdById String
  name        String
  html        String   @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([workspaceId])
}

// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
// EMAIL TRACKING (open / click events)
// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model EmailTrackingEvent {
  id         String   @id @default(cuid())
  campaignId String
  emailJobId String
  email      String
  type       String   // "OPEN" | "CLICK"
  url        String?  // destination URL for clicks
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  campaign Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  emailJob EmailJob  @relation(fields: [emailJobId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@index([emailJobId])
  @@index([email])
}

// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
// SLA RULES
// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model SlaRule {
  id                   String   @id @default(cuid())
  workspaceId          String
  name                 String
  firstResponseMinutes Int      // minutes to first reply
  resolutionMinutes    Int      // minutes to resolution
  appliesTo            String   @default("ALL") // ALL | TAG | ASSIGNEE
  tagName              String?  // if appliesTo=TAG
  assigneeId           String?  // if appliesTo=ASSIGNEE
  active               Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  assignee  User?     @relation(fields: [assigneeId], references: [id])

  @@index([workspaceId])
}

// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
// EMAIL SUPPRESSION (unsubscribes, bounces)
// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model EmailSuppression {
  id            String   @id @default(cuid())
  workspaceId   String
  email         String
  reason        String   @default("UNSUBSCRIBED") // UNSUBSCRIBED | BOUNCED | COMPLAINT
  source        String   @default("MANUAL")       // MANUAL | BOUNCE | UNSUBSCRIBE | COMPLAINT
  addedByUserId String?
  detail        String?  @db.Text                 // bounce error message / reason detail
  campaignId    String?
  createdAt     DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  addedBy   User?     @relation("SuppressionAddedBy", fields: [addedByUserId], references: [id])
  campaign  Campaign? @relation(fields: [campaignId], references: [id])

  @@unique([workspaceId, email])
  @@index([workspaceId])
}

// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
// OUTBOUND WEBHOOKS
// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model WebhookEndpoint {
  id          String   @id @default(cuid())
  workspaceId String
  url         String
  secret      String   // HMAC-SHA256 signing secret (generated on create)
  events      String[] // e.g. ["conversation.resolved", "email.bounced"]
  active      Boolean  @default(true)
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace  Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  deliveries WebhookDelivery[]

  @@index([workspaceId])
}

model WebhookDelivery {
  id           String    @id @default(cuid())
  endpointId   String
  event        String
  payload      Json
  status       String    @default("PENDING") // PENDING | SUCCESS | FAILED
  statusCode   Int?
  responseBody String?   @db.Text
  attemptCount Int       @default(0)
  lastAttemptAt DateTime?
  createdAt    DateTime  @default(now())

  endpoint WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@index([endpointId])
}

// ─────────────────────────────────────────────────────────────────────────────
// E-SIGNING (PandaDoc-style document signing requests)
// ─────────────────────────────────────────────────────────────────────────────

enum SigningRequestStatus {
  DRAFT
  SENT
  VIEWED
  SIGNED
  EXPIRED
  VOIDED
}

model SigningRequest {
  id             String               @id @default(cuid())
  workspaceId    String
  batchId        String?
  title          String
  content        String               @db.Text
  recipientName  String
  recipientEmail String
  fieldValues    Json                 @default("{}")
  attachments    Json                 @default("[]")
  ccEmails       String[]             @default([])
  token          String               @unique @default(cuid())
  status         SigningRequestStatus @default(DRAFT)
  expiresAt      DateTime?
  sentAt         DateTime?
  viewedAt       DateTime?
  signedAt       DateTime?
  voidedAt       DateTime?
  reminderSentAt DateTime?
  reminderCount  Int                  @default(0)
  signatureImage String?              @db.Text
  signedPdfData  String?              @db.Text
  signerIp       String?
  signerAgent    String?
  sentById       String
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  workspace Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sentBy    User         @relation("SigningRequestsSentBy", fields: [sentById], references: [id])
  batch     SigningBatch? @relation(fields: [batchId], references: [id])

  @@index([workspaceId])
  @@index([token])
}

// ─────────────────────────────────────────────────────────────────────────────
// SIGNING TEMPLATES & BATCHES
// ─────────────────────────────────────────────────────────────────────────────

model SigningTemplate {
  id          String   @id @default(cuid())
  workspaceId String
  title       String
  description String?
  content     String   @db.Text
  fieldDefs   Json     @default("[]") // [{key, label, defaultValue?}]
  archived    Boolean  @default(false)
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User         @relation("SigningTemplateCreatedBy", fields: [createdById], references: [id])
  batches   SigningBatch[]

  @@index([workspaceId])
}

model SigningBatch {
  id          String   @id @default(cuid())
  workspaceId String
  templateId  String?
  title       String
  totalCount  Int      @default(0)
  sentCount   Int      @default(0)
  signedCount Int      @default(0)
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  template  SigningTemplate? @relation(fields: [templateId], references: [id])
  requests  SigningRequest[]

  @@index([workspaceId])
}

