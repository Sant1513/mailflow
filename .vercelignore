# Build outputs. Vercel excludes .next by default but not our isolated
# verification dist dir, which is ~450MB — uploading it aborts the deploy.
.next
.next-verify

# Never needed by the build, and some are large or sensitive.
node_modules
.git
tests
# Exclude test/dev scripts but keep build helpers (.mjs) for postinstall
scripts/*.ts
coverage
*.log
.env
.env.local

# Laptop server runtime (its own node_modules with Postgres binaries); never part of the Vercel build.
laptop-server
